{
  "name": "TPDB Data Engineering",
  "dockerComposeFile": ["../docker/develop/docker-compose.yaml"],
  "service": "airflow-scheduler",
  "workspaceFolder": "/opt/airflow/dags",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "donjayamanne.python-extension-pack",
        "ms-python.debugpy",
        "ms-python.pylint",
        "ms-python.black-formatter",
        "oderwat.indent-rainbow",
        "ms-python.isort"
      ]
    }
  },
  "postCreateCommand": "pip install -r /opt/airflow/docker/develop/requirements.txt"
}